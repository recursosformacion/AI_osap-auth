# Variables de entorno de osap-auth (Auth API v1.0)
# Copiar a .env y rellenar. Nunca commitear secretos reales.

OSAP_AUTH_DB_HOST=127.0.0.1
OSAP_AUTH_DB_PORT=3306
OSAP_AUTH_DB_NAME=osap_auth
OSAP_AUTH_DB_USER=osap_auth
OSAP_AUTH_DB_PASSWORD=

# Claves criptográficas (generar con `python -m infrastructure.crypto.keygen`)
OSAP_AUTH_EMAIL_PEPPER=
OSAP_AUTH_EMAIL_AEAD_KEY=
OSAP_AUTH_TOKEN_PEPPER=
OSAP_AUTH_JWT_PRIVATE_KEY=
OSAP_AUTH_JWT_PUBLIC_KEY=
OSAP_AUTH_JWT_KID=osap-auth-v1

OSAP_AUTH_ISSUER=https://auth.osap
OSAP_AUTH_AUDIENCE=osap-api
